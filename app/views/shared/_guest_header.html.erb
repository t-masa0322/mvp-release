<header class="bg-green-600 text-white shadow-[0_1px_0_rgba(255,255,255,0.08)_inset]">
  <div class="mx-auto flex h-18 w-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="text-2xl font-bold tracking-tight sm:text-3xl">
      <%= link_to "Fit Bloom", root_path, class: "hover:opacity-90" %>
    </div>

    <div class="flex items-center gap-3 sm:gap-5">
      <%= link_to "ログイン",
            login_path,
            class: "text-sm font-bold text-white/95 transition hover:text-white hover:opacity-90 sm:text-lg" %>

      <%= link_to "新規登録",
            new_signup_path,
            class: "inline-flex items-center justify-center rounded-xl bg-amber-400 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-amber-500 sm:px-5 sm:text-base" %>
    </div>
  </div>
</header>
