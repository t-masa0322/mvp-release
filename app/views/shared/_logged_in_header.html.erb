<div data-controller="menu">
  <header class="bg-green-600 text-white">
    <div class="mx-auto flex h-16 items-center justify-between px-5 sm:px-6 lg:px-8">
      <div class="text-2xl font-bold sm:text-3xl">
        <%= link_to "Fit Bloom", home_path %>
      </div>

      <div class="hidden md:block">
        <%= button_to "ログアウト",
              logout_path,
              method: :delete,
              form_class: "inline",
              class: "bg-transparent p-0 text-base font-bold text-white hover:opacity-80" %>
      </div>

      <button
        type="button"
        class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
        data-action="click->menu#toggle"
      >
        <span class="block h-0.5 w-8 bg-white"></span>
        <span class="block h-0.5 w-8 bg-white"></span>
        <span class="block h-0.5 w-8 bg-white"></span>
      </button>
    </div>
  </header>

  <div
    data-menu-target="panel"
    class="hidden border-t border-green-700 bg-green-600 px-6 py-6 text-white md:hidden"
  >
    <nav>
      <ul class="space-y-4 text-lg font-bold">
        <li><%= link_to "ホーム", home_path, class: "block hover:opacity-80" %></li>
        <li><%= link_to "運動記録", new_exercise_log_path, class: "block hover:opacity-80" %></li>
        <li><%= link_to "投稿", posts_path, class: "block hover:opacity-80" %></li>
        <li><%= link_to "マイページ", mypage_path, class: "block hover:opacity-80" %></li>
        <li>
          <%= button_to "ログアウト",
                logout_path,
                method: :delete,
                form_class: "inline",
                class: "bg-transparent p-0 text-left text-lg font-bold text-white hover:opacity-80" %>
        </li>
      </ul>
    </nav>
  </div>
</div>
