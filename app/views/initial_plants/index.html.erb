<main class="flex-1 bg-gray-100 py-10">
  <div class="mx-auto w-full max-w-5xl px-4">
    <h1 class="mb-8 text-center text-2xl font-bold text-green-700 sm:text-3xl">
      育てる植物を選択
    </h1>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @plants.each do |plant| %>
        <%= link_to plant_path(plant), class: "block rounded-2xl bg-white p-6 shadow-sm hover:bg-gray-50" do %>
          <% if plant.image.attached? %>
            <div class="mb-4 overflow-hidden rounded-xl bg-green-50">
              <%= image_tag plant.image, class: "h-40 w-full object-cover" %>
            </div>
          <% else %>
            <div class="mb-4 flex h-40 items-center justify-center rounded-xl bg-green-50 text-green-700">
              <span class="font-bold"><%= plant.name %></span>
            </div>
          <% end %>

          <h2 class="mb-2 text-xl font-bold text-gray-800"><%= plant.name %></h2>
          <p class="text-sm text-gray-600"><%= plant.description %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</main>
