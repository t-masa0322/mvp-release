<main class="flex-1 bg-gray-100 py-10">
  <div class="mx-auto w-full max-w-4xl px-4 space-y-8">

    <div class="rounded-2xl border border-gray-400 bg-white p-6 shadow-sm">
      <h1 class="mb-6 text-2xl font-bold text-gray-800">今日の運動記録</h1>

      <% if @today_exercise_logs.present? %>
        <p class="mb-6 text-2xl font-bold text-gray-800">
          今日の獲得ポイント <%= @today_earned_points %>pt
        </p>

        <ul class="mb-8 list-disc pl-6 text-2xl font-bold text-green-600 space-y-2">
          <% @today_exercise_logs.each do |exercise_log| %>
            <li>
              <%= exercise_type_label(exercise_log.exercise_type) %>
              <%= exercise_log.duration_minutes %>分
            </li>
          <% end %>
        </ul>

        <p class="mb-8 text-2xl font-bold text-gray-800">
          お疲れ様でした。
        </p>
      <% else %>
        <p class="mb-8 text-lg text-gray-700">
          今日はまだ運動記録がありません。
        </p>
      <% end %>

      <div class="flex flex-col gap-4 sm:flex-row">
        <%= link_to "過去の運動履歴を見る",
              exercise_logs_path,
              class: "inline-block rounded-lg bg-green-600 px-6 py-3 text-center font-bold text-white hover:bg-green-700" %>

        <%= link_to "今日の運動を記録する",
              new_exercise_log_path,
              class: "inline-block rounded-lg bg-green-600 px-6 py-3 text-center font-bold text-white hover:bg-green-700" %>
      </div>
    </div>

    <% if @current_user_plant.present? %>
      <div class="rounded-2xl border border-gray-400 bg-white p-6 shadow-sm">
        <h2 class="mb-6 text-2xl font-bold text-gray-800">育成中の植物</h2>

        <% if @current_user_plant.next_stage.present? %>
          <div class="mb-6 text-right text-lg font-bold text-gray-800">
            次の成長までに必要なポイント
            <span class="ml-2 text-green-700"><%= @current_user_plant.points_to_next_stage %>pt</span>
          </div>
        <% else %>
          <div class="mb-6 text-right text-lg font-bold text-green-700">
            最終段階まで成長しています
          </div>
        <% end %>

        <div class="mb-8 flex flex-col items-center gap-6 sm:flex-row sm:items-center">
          <div class="flex h-36 w-36 items-center justify-center rounded-full bg-gray-200 text-sm text-gray-700">
            植物の画像
          </div>

          <div class="text-center sm:text-left">
            <p class="mb-3 text-2xl font-bold text-gray-800">
              <%= @current_user_plant.plant.name %>
            </p>

            <p class="text-base text-gray-700">
              成長段階：
              <%= @current_user_plant.current_stage&.stage_order || "-" %>
              （<%= @current_user_plant.current_stage&.name || "未設定" %>）
            </p>
          </div>
        </div>

        <div class="text-center">
          <%= link_to "他の植物にかえる",
                plants_path,
                class: "inline-block rounded-lg bg-green-600 px-8 py-3 font-bold text-white hover:bg-green-700" %>
        </div>
      </div>
    <% end %>

  </div>
</main>
