<main class="flex-1 bg-gray-50 py-8 sm:py-10">
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
    <section class="rounded-[28px] border border-gray-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,0.05)] sm:p-8 lg:p-10">
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-bold tracking-[0.2em] text-green-700">MY PAGE</p>
            <h1 class="mt-2 text-3xl font-extrabold text-gray-900 sm:text-5xl">
              マイページ
            </h1>
          </div>

          <div class="rounded-2xl bg-green-50 px-5 py-4">
            <p class="text-sm font-bold text-gray-600">累計獲得ポイント</p>
            <p class="mt-2 text-3xl font-extrabold text-green-600 sm:text-4xl">
              <%= number_with_delimiter(current_user.total_growth_points) %>
            </p>
          </div>
        </div>

        <div class="grid gap-8 lg:grid-cols-[240px_1fr] lg:items-center">
          <div class="flex justify-center lg:justify-start">
            <% if current_user.profile_image.attached? %>
              <%= image_tag current_user.profile_image,
                    class: "h-44 w-44 rounded-full border border-gray-200 object-cover shadow-sm sm:h-52 sm:w-52" %>
            <% else %>
              <div class="flex h-44 w-44 items-center justify-center rounded-full bg-gray-100 text-sm text-gray-600 sm:h-52 sm:w-52">
                プロフィール画像
              </div>
            <% end %>
          </div>

          <div class="space-y-5">
            <div>
              <p class="text-sm font-bold text-gray-500">表示名</p>
              <p class="mt-1 text-3xl font-extrabold text-gray-900 sm:text-4xl">
                <%= current_user.display_name %>
              </p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl bg-gray-50 px-5 py-4">
                <p class="text-sm font-bold text-gray-500">ユーザーID</p>
                <p class="mt-2 text-xl font-bold text-gray-800">
                  <%= current_user.name %>
                </p>
              </div>

              <div class="rounded-2xl bg-gray-50 px-5 py-4">
                <p class="text-sm font-bold text-gray-500">メールアドレス</p>
                <p class="mt-2 break-all text-lg font-bold text-gray-800">
                  <%= current_user.email %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:max-w-2xl">
          <%= link_to "プロフィールを編集",
                edit_mypage_path,
                class: "inline-flex items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-base font-bold text-white transition hover:bg-green-700 sm:text-lg" %>

          <%= button_to "ログアウト",
                logout_path,
                method: :delete,
                class: "inline-flex w-full items-center justify-center rounded-2xl border border-gray-300 bg-white px-6 py-4 text-base font-bold text-gray-700 transition hover:bg-gray-50 sm:text-lg" %>
        </div>
      </div>
    </section>
  </div>
</main>
