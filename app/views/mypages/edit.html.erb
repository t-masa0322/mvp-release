<main class="flex-1 bg-gray-50 py-8 sm:py-10">
  <div class="mx-auto w-full max-w-4xl px-4 sm:px-6">
    <section class="rounded-[28px] border border-gray-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,0.05)] sm:p-8 lg:p-10">
      <div class="mb-8">
        <p class="text-sm font-bold tracking-[0.2em] text-green-700">PROFILE EDIT</p>
        <h1 class="mt-2 text-3xl font-extrabold text-gray-900 sm:text-5xl">
          プロフィール編集
        </h1>
      </div>

      <% if flash.now[:alert].present? %>
        <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700">
          <%= flash.now[:alert] %>
        </div>
      <% end %>

      <%= form_with model: @user,
            url: mypage_path,
            method: :patch,
            local: true,
            data: { turbo: false },
            class: "space-y-8" do |f| %>

        <div class="grid gap-8 lg:grid-cols-[220px_1fr] lg:items-start">
          <div class="flex flex-col items-center">
            <% if @user.profile_image.attached? %>
              <%= image_tag @user.profile_image,
                    class: "h-40 w-40 rounded-full border border-gray-200 object-cover shadow-sm sm:h-48 sm:w-48" %>
            <% else %>
              <div class="flex h-40 w-40 items-center justify-center rounded-full bg-gray-100 text-sm text-gray-600 sm:h-48 sm:w-48">
                プロフィール画像
              </div>
            <% end %>
          </div>

          <div class="space-y-8">
            <div>
              <%= f.label :display_name, "ユーザー名", class: "mb-3 block text-lg font-bold text-gray-800" %>
              <%= f.text_field :display_name,
                    class: "w-full rounded-2xl border border-gray-300 bg-white px-5 py-4 text-lg text-gray-900 placeholder:text-gray-400 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-100" %>
              <p class="mt-2 text-sm text-gray-500">
                一覧や投稿で表示される名前です。
              </p>
            </div>

            <div>
              <%= f.label :profile_image, "プロフィール画像", class: "mb-3 block text-lg font-bold text-gray-800" %>

              <div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 px-5 py-6">
                <%= f.file_field :profile_image,
                      class: "block w-full text-base text-gray-700 file:mr-4 file:rounded-xl file:border-0 file:bg-green-600 file:px-4 file:py-2 file:font-bold file:text-white hover:file:bg-green-700" %>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-4 pt-2 sm:grid-cols-2">
          <%= f.submit "更新する",
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-green-700" %>

          <%= link_to "戻る",
                mypage_path,
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-gray-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-gray-700" %>
        </div>
      <% end %>
    </section>
  </div>
</main>
