<main class="flex-1 bg-gray-50 py-8 sm:py-10">
  <div class="mx-auto w-full max-w-4xl px-4 sm:px-6">
    <section class="rounded-[28px] border border-gray-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,0.05)] sm:p-8 lg:p-10">
      <div class="mb-8">
        <p class="text-sm font-bold tracking-[0.2em] text-green-700">EXERCISE LOG</p>
        <h1 class="mt-2 text-3xl font-extrabold text-gray-900 sm:text-5xl">
          運動を記録する
        </h1>
        <p class="mt-3 text-sm leading-7 text-gray-600 sm:text-base">
          今日の運動内容を記録して、植物の成長につなげましょう。
        </p>
      </div>

      <% if flash.now[:alert].present? %>
        <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700">
          <%= flash.now[:alert] %>
        </div>
      <% end %>

      <%= form_with model: @exercise_log,
            url: exercise_logs_path,
            local: true,
            data: { turbo: false },
            class: "space-y-8" do |f| %>

        <div class="grid gap-8">
          <div>
            <%= f.label :exercise_type, "運動種別", class: "mb-3 block text-lg font-bold text-gray-800" %>
            <%= f.select :exercise_type,
                  [
                    ["散歩", "walk"],
                    ["筋トレ", "strength_training"],
                    ["ストレッチ", "stretching"],
                    ["ランニング", "running"],
                    ["ヨガ", "yoga"]
                  ],
                  {},
                  class: "w-full rounded-2xl border border-gray-300 bg-white px-5 py-4 text-lg text-gray-900 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-100" %>
          </div>

          <div>
            <%= f.label :exercised_on, "運動日", class: "mb-3 block text-lg font-bold text-gray-800" %>
            <%= f.date_field :exercised_on,
                  class: "w-full rounded-2xl border border-gray-300 bg-white px-5 py-4 text-lg text-gray-900 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-100" %>
          </div>

          <div>
            <%= f.label :duration_minutes, "運動時間", class: "mb-3 block text-lg font-bold text-gray-800" %>
            <%= f.select :duration_minutes,
                  [["10分", 10], ["20分", 20], ["30分", 30], ["40分", 40], ["50分", 50], ["60分", 60]],
                  {},
                  class: "w-full rounded-2xl border border-gray-300 bg-white px-5 py-4 text-lg text-gray-900 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-100" %>
          </div>

          <div>
            <%= f.label :memo, "メモ", class: "mb-3 block text-lg font-bold text-gray-800" %>
            <%= f.text_area :memo,
                  rows: 7,
                  class: "w-full rounded-2xl border border-gray-300 bg-white px-5 py-4 text-lg text-gray-900 placeholder:text-gray-400 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-100",
                  placeholder: "運動の内容や感想をメモできます" %>
            <p class="mt-2 text-sm text-gray-500">
              例：30分散歩した、筋トレを3セット行った など
            </p>
          </div>
        </div>

        <div class="grid gap-4 pt-2 sm:grid-cols-2">
          <%= f.submit "記録する",
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-green-700" %>

          <%= link_to "戻る",
                home_path,
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-gray-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-gray-700" %>
        </div>
      <% end %>
    </section>
  </div>
</main>
