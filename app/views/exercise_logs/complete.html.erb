<main class="flex-1 bg-gray-50 py-8 sm:py-10">
  <div class="mx-auto w-full max-w-4xl px-4 sm:px-6">
    <section class="rounded-[28px] border border-gray-200 bg-white p-6 text-center shadow-[0_8px_30px_rgba(15,23,42,0.05)] sm:p-8 lg:p-10">
      <div class="mx-auto max-w-2xl">
        <p class="text-sm font-bold tracking-[0.2em] text-green-700">EXERCISE LOG</p>

        <h1 class="mt-4 text-3xl font-extrabold leading-tight text-gray-900 sm:text-5xl">
          運動を記録しました。
        </h1>

        <p class="mt-5 text-3xl font-extrabold text-gray-900 sm:text-5xl">
          <span class="text-green-600"><%= @earned_points %>pt</span>チャージされました。
        </p>

        <div class="mt-10 flex justify-center">
          <% if @current_user_plant&.plant&.image_exists? %>
            <%= image_tag @current_user_plant.plant.image_file_name,
                  class: "h-56 w-56 rounded-full border border-gray-200 object-contain shadow-sm sm:h-64 sm:w-64" %>
          <% else %>
            <div class="flex h-56 w-56 items-center justify-center rounded-full bg-gray-100 text-xl text-gray-600 sm:h-64 sm:w-64">
              植物の画像
            </div>
          <% end %>
        </div>

        <% if @current_user_plant.present? %>
          <div class="mt-10 rounded-3xl bg-green-50 px-6 py-5">
            <% if @current_user_plant.next_stage.present? %>
              <p class="text-sm font-bold text-gray-600">
                次の成長までに必要なポイント
              </p>
              <p class="mt-2 text-3xl font-extrabold text-green-600 sm:text-4xl">
                <%= @current_user_plant.points_to_next_stage %>pt
              </p>

              <% current_points = @current_user_plant.accumulated_points %>
              <% next_points = @current_user_plant.next_stage.required_points %>
              <% progress = next_points.positive? ? ((current_points.to_f / next_points) * 100).floor : 0 %>
              <% progress = [[progress, 0].max, 100].min %>

              <div class="mx-auto mt-5 max-w-md">
                <div class="mb-2 flex items-center justify-between text-xs font-bold text-gray-500 sm:text-sm">
                  <span>現在の進捗</span>
                  <span><%= current_points %> / <%= next_points %>pt</span>
                </div>
                <div class="h-3 rounded-full bg-white">
                  <div class="h-3 rounded-full bg-green-500 transition-all" style="width: <%= progress %>%"></div>
                </div>
              </div>
            <% else %>
              <p class="text-2xl font-extrabold text-green-600 sm:text-3xl">
                最終段階まで成長しています
              </p>
            <% end %>
          </div>
        <% end %>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          <%= link_to "履歴を見る",
                exercise_logs_path,
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-green-700" %>

          <%= link_to "ホームに戻る",
                home_path,
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-gray-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-gray-700" %>
        </div>
      </div>
    </section>
  </div>
</main>
