<main class="flex-1 bg-gray-50 py-8 sm:py-10">
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
    <section class="rounded-[28px] border border-gray-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,0.05)] sm:p-8 lg:p-10">
      <div class="mb-8">
        <p class="text-sm font-bold tracking-[0.2em] text-green-700">EXERCISE LOG</p>
        <h1 class="mt-2 text-3xl font-extrabold text-gray-900 sm:text-5xl">
          <%= @date.strftime("%Y/%m/%d") %> の運動記録
        </h1>
      </div>

      <% if @exercise_logs.present? %>
        <div class="space-y-5">
          <% @exercise_logs.each do |exercise_log| %>
            <div class="rounded-[24px] border border-gray-200 bg-gray-50 p-5 sm:p-6">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-bold text-green-700">
                    <%= exercise_type_label(exercise_log.exercise_type) %>
                  </div>

                  <p class="mt-4 text-2xl font-extrabold text-gray-900 sm:text-3xl">
                    <%= exercise_log.duration_minutes %>分
                    <span class="ml-2 text-green-600"><%= exercise_log.earned_points %>pt</span>
                  </p>

                  <% if exercise_log.memo.present? %>
                    <div class="mt-4 rounded-2xl bg-white px-4 py-3">
                      <p class="text-sm font-bold text-gray-500">メモ</p>
                      <p class="mt-2 whitespace-pre-wrap text-base leading-7 text-gray-700">
                        <%= exercise_log.memo %>
                      </p>
                    </div>
                  <% end %>
                </div>

                <div class="grid gap-3 sm:min-w-[180px]">
                  <%= link_to "編集",
                        edit_exercise_log_path(exercise_log),
                        class: "inline-flex w-full items-center justify-center rounded-2xl bg-green-600 px-5 py-3 text-base font-bold text-white transition hover:bg-green-700" %>

                  <%= button_to "削除",
                        exercise_log_path(exercise_log),
                        method: :delete,
                        data: { turbo_confirm: "この記録を削除しますか？" },
                        class: "inline-flex w-full items-center justify-center rounded-2xl bg-red-500 px-5 py-3 text-base font-bold text-white transition hover:bg-red-600" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-[24px] border border-gray-200 bg-gray-50 px-6 py-10 text-center">
          <p class="text-xl font-bold text-gray-700">
            この日の運動記録はありません。
          </p>
        </div>
      <% end %>

      <div class="mt-8">
        <%= link_to "カレンダーに戻る",
              exercise_logs_path(month: @date.strftime("%Y-%m")),
              class: "inline-flex items-center justify-center rounded-2xl bg-gray-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-gray-700" %>
      </div>
    </section>
  </div>
</main>
