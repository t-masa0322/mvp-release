<main class="flex-1 bg-gray-100 py-10">
  <div class="mx-auto w-full max-w-xl px-4">
    <div class="rounded-2xl bg-white p-6 shadow-sm sm:p-8">
      <h1 class="mb-6 text-center text-2xl font-bold text-green-700 sm:text-3xl">
        ログイン
      </h1>

      <% if flash.now[:alert].present? %>
        <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-sm text-red-700">
          <%= flash.now[:alert] %>
        </div>
      <% end %>

      <%= form_with url: login_path, scope: :session, local: true, class: "space-y-6" do |f| %>
        <div>
          <%= f.label :email, "メールアドレス", class: "mb-2 block text-sm font-bold text-gray-700" %>
          <%= f.email_field :email,
                class: "w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-green-500 focus:outline-none",
                placeholder: "example@example.com" %>
        </div>

        <div>
          <%= f.label :password, "パスワード", class: "mb-2 block text-sm font-bold text-gray-700" %>
          <%= f.password_field :password,
                class: "w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-green-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.submit "ログイン",
                class: "w-full rounded-lg bg-green-600 px-4 py-3 font-bold text-white hover:bg-green-700" %>
        </div>
      <% end %>

      <div class="mt-6 text-center text-sm text-gray-700 sm:text-base">
        <p class="mb-4 underline underline-offset-2">
          パスワードを忘れた場合
        </p>

        <p>
          まだ登録していない方はこちらから
          <%= link_to "新規会員登録", new_signup_email_path, class: "font-bold text-green-600 hover:opacity-80" %>
        </p>
      </div>
    </div>
  </div>
</main>
