<main class="flex-1 bg-[#f7f8f6] py-8 sm:py-10">
  <div class="mx-auto w-full max-w-4xl px-4 sm:px-6">
    <section class="rounded-[32px] border border-gray-200/80 bg-white p-6 shadow-[0_10px_30px_rgba(15,23,42,0.04)] sm:p-8 lg:p-10">
      <div class="mx-auto max-w-3xl">
        <div class="mb-8 text-center">
          <p class="text-[12px] font-semibold tracking-[0.24em] text-green-700/80">
            LOGIN
          </p>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            ログイン
          </h1>
          <p class="mt-4 text-sm leading-7 text-slate-600 sm:text-base">
            登録したメールアドレスとパスワードを入力して、Fit Bloomを始めよう。
          </p>
        </div>

        <% if flash.now[:alert].present? %>
          <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
            <%= flash.now[:alert] %>
          </div>
        <% end %>

        <%= form_with scope: :session,
          url: login_path,
          local: true,
          data: { turbo: false },
          class: "space-y-8" do |f| %>

          <div>
            <%= f.label :email, "メールアドレス", class: "mb-3 block text-lg font-bold text-slate-800" %>
            <%= f.email_field :email,
                  placeholder: "example@example.com",
                  class: "w-full rounded-2xl border border-slate-300 bg-white px-5 py-4 text-lg text-slate-900 placeholder:text-slate-400 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-100" %>
          </div>

          <div>
            <%= f.label :password, "パスワード", class: "mb-3 block text-lg font-bold text-slate-800" %>
            <%= f.password_field :password,
                  class: "w-full rounded-2xl border border-slate-300 bg-white px-5 py-4 text-lg text-slate-900 focus:border-green-500 focus:outline-none focus:ring-2 focus:ring-green-100" %>
          </div>

          <div class="pt-2">
            <%= f.submit "ログイン",
                  class: "inline-flex w-full items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-green-700" %>
          </div>
        <% end %>

        <div class="mt-8 space-y-5 text-center">
          <div>
            <%= link_to "パスワードを忘れた場合",
                  new_password_reset_path,
                  class: "text-base text-slate-600 underline underline-offset-4 hover:text-slate-800 sm:text-lg" %>
          </div>

          <p class="text-base text-slate-600 sm:text-lg">
            まだ登録していない方は
            <%= link_to "新規会員登録",
                  new_signup_path,
                  class: "font-bold text-green-700 underline underline-offset-4 hover:text-green-800" %>
          </p>
        </div>
      </div>
    </section>
  </div>
</main>
