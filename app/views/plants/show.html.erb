<main class="flex-1 bg-[#f7f8f6] py-8 sm:py-10">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <section class="rounded-[32px] border border-gray-200/80 bg-white p-6 shadow-[0_10px_30px_rgba(15,23,42,0.04)] sm:p-8 lg:p-10">
      <div class="grid gap-10 lg:grid-cols-[1fr_420px] lg:items-start">
        <div>
          <p class="text-[12px] font-semibold tracking-[0.24em] text-green-700/80">
            PLANT SELECT
          </p>

          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            <%= @plant.name %>
          </h1>

          <p class="mt-6 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
            <%= @plant.description %>
          </p>

          <% final_stage = @plant.plant_stages.last %>
          <% if final_stage.present? %>
            <div class="mt-8 inline-flex rounded-3xl border border-green-100 bg-green-50 px-6 py-5">
              <div>
                <p class="text-sm font-semibold text-slate-500">
                  開花までに必要なポイント
                </p>
                <p class="mt-2 text-4xl font-extrabold tracking-tight text-green-600 sm:text-5xl">
                  <%= number_with_delimiter(final_stage.required_points) %>pt
                </p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="flex h-[340px] w-full max-w-[420px] items-center justify-center rounded-[32px] bg-gradient-to-br from-slate-50 to-green-50 p-8 ring-1 ring-slate-100">
            <% if @plant.image_exists? %>
              <%= image_tag @plant.image_file_name, class: "h-full w-full object-contain" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center rounded-[24px] bg-white text-xl font-semibold text-slate-500">
                植物の画像
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-12 rounded-[28px] bg-slate-50 px-5 py-6 sm:px-7 sm:py-7">
        <div class="mb-6 flex items-center justify-between">
          <h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
            成長ステップ
          </h2>
          <p class="text-sm font-medium text-slate-500">
            必要累計ポイント
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-3">
          <% @plant.plant_stages.each do |stage| %>
            <div class="rounded-[24px] bg-white px-5 py-6 ring-1 ring-slate-100">
              <div class="flex items-center gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-green-50 text-sm font-bold text-green-700">
                  <%= stage.stage_order %>
                </div>

                <div>
                  <p class="text-xl font-bold tracking-tight text-slate-900">
                    <%= stage.name %>
                  </p>
                  <p class="mt-1 text-sm text-slate-500">
                    <%= stage.stage_order == 1 ? "スタート" : "#{number_with_delimiter(stage.required_points)}pt" %>
                  </p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <% if session[:initial_plant_selection] %>
          <%= button_to "この植物を育てる",
                initial_plants_path(plant_id: @plant.id),
                method: :post,
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-green-700" %>

          <%= link_to "一覧に戻る",
                initial_plants_path,
                class: "inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-6 py-4 text-lg font-bold text-slate-700 transition hover:border-green-200 hover:bg-green-50 hover:text-green-700" %>
        <% else %>
          <%= button_to "この植物を育てる",
                select_plant_path(@plant),
                method: :post,
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-green-700" %>

          <%= link_to "一覧に戻る",
                plants_path,
                class: "inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-6 py-4 text-lg font-bold text-slate-700 transition hover:border-green-200 hover:bg-green-50 hover:text-green-700" %>
        <% end %>
      </div>
    </section>
  </div>
</main>
