<main class="flex-1 bg-[#f7f8f6] py-8 sm:py-10">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <section class="rounded-[32px] border border-gray-200/80 bg-white p-6 shadow-[0_10px_30px_rgba(15,23,42,0.04)] sm:p-8 lg:p-10">
      <div class="mb-8 text-center sm:mb-10">
        <p class="text-[12px] font-semibold tracking-[0.24em] text-green-700/80">
          PLANT SELECT
        </p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          育てる植物を選択
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">
          育てたい植物を選ぶと、日々の運動記録にあわせて少しずつ成長していきます。
          植物ごとに成長のしやすさが異なります。
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% @plants.each do |plant| %>
          <%= link_to plant_path(plant),
                class: "group block overflow-hidden rounded-[28px] border border-gray-200 bg-white transition duration-200 hover:-translate-y-1 hover:border-green-100 hover:shadow-[0_12px_30px_rgba(15,23,42,0.08)]" do %>

            <div class="p-5 sm:p-6">
              <div class="flex min-h-[240px] items-center justify-center rounded-[24px] bg-gradient-to-br from-slate-50 to-green-50 p-6">
                <% if plant.image_exists? %>
                  <%= image_tag plant.image_file_name,
                        class: "h-48 w-full object-contain transition duration-200 group-hover:scale-[1.03] sm:h-56" %>
                <% else %>
                  <div class="flex h-48 w-full items-center justify-center rounded-[20px] bg-white text-base font-semibold text-slate-500 sm:h-56">
                    <%= plant.name %>
                  </div>
                <% end %>
              </div>

              <div class="mt-6">
                <div class="flex items-center justify-between gap-4">
                  <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                    <%= plant.name %>
                  </h2>

                  <% final_stage = plant.plant_stages.last %>
                  <% if final_stage.present? %>
                    <span class="shrink-0 rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700 sm:text-sm">
                      開花 <%= number_with_delimiter(final_stage.required_points) %>pt
                    </span>
                  <% end %>
                </div>

                <p class="mt-4 text-base leading-8 text-slate-600">
                  <%= plant.description %>
                </p>

                <div class="mt-6 inline-flex items-center text-sm font-semibold text-green-700 transition group-hover:text-green-800">
                  詳細を見る
                  <span class="ml-2 transition group-hover:translate-x-1">→</span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>
</main>
