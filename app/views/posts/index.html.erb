<main class="flex-1 bg-gray-50 py-8 sm:py-10">
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
    <div class="mb-8 flex flex-col gap-4 sm:mb-10 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm font-bold tracking-[0.2em] text-green-700">COMMUNITY</p>
        <h1 class="mt-2 text-3xl font-extrabold text-gray-900 sm:text-5xl">
          みんなの投稿一覧
        </h1>
      </div>

      <% if logged_in? %>
        <%= link_to "投稿する",
              new_post_path,
              class: "inline-flex items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-base font-bold text-white transition hover:bg-green-700 sm:min-w-[180px] sm:text-lg" %>
      <% end %>
    </div>

    <% if @posts.present? %>
      <div class="space-y-6">
        <% @posts.each do |post| %>
          <%= link_to post_path(post), class: "block rounded-[28px] border border-gray-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,0.05)] transition hover:-translate-y-0.5 hover:shadow-[0_10px_32px_rgba(15,23,42,0.08)] sm:p-6" do %>
            <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-600 sm:text-base">
              <span class="font-bold text-gray-900"><%= post.user.display_name %></span>
              <span>累計 <%= number_with_delimiter(post.user.total_growth_points) %>pt</span>

              <% if post.user.user_plants.growing.first&.plant&.name.present? %>
                <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-sm font-bold text-green-700">
                  <%= post.user.user_plants.growing.first.plant.name %>
                </span>
              <% end %>
            </div>

            <p class="mb-5 text-sm font-medium text-gray-500 sm:text-base">
              <%= post.created_at.strftime("%Y.%m.%d") %>
            </p>

            <p class="text-lg text-gray-800 sm:text-2xl">
              <%= truncate(post.body, length: 90) %>
            </p>

            <% if post.image.attached? %>
              <div class="overflow-hidden rounded-[24px] bg-gray-100">
                <%= image_tag post.image, class: "h-[220px] w-full object-cover sm:h-[320px]" %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-[28px] border border-gray-200 bg-white px-6 py-12 text-center shadow-[0_8px_30px_rgba(15,23,42,0.05)] sm:px-8">
        <p class="text-xl font-bold text-gray-700 sm:text-2xl">
          まだ投稿はありません。
        </p>

        <% if logged_in? %>
          <div class="mt-6">
            <%= link_to "最初の投稿をする",
                  new_post_path,
                  class: "inline-flex items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-base font-bold text-white transition hover:bg-green-700" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</main>
