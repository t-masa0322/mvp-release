<main class="flex-1 bg-gray-50 py-8 sm:py-10">
  <div class="mx-auto w-full max-w-4xl px-4 sm:px-6">
    <section class="rounded-[28px] border border-gray-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,0.05)] sm:p-8 lg:p-10">
      <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-600 sm:text-base">
        <span class="font-bold text-gray-900"><%= @post.user.display_name %></span>
        <span>累計 <%= number_with_delimiter(@post.user.total_growth_points) %>pt</span>

        <% if @post.user.user_plants.growing.first&.plant&.name.present? %>
          <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-sm font-bold text-green-700">
            <%= @post.user.user_plants.growing.first.plant.name %>
          </span>
        <% end %>
      </div>

      <p class="mb-8 text-sm font-medium text-gray-500 sm:text-base">
        <%= @post.created_at.strftime("%Y.%m.%d") %>
      </p>

      <div class="mb-8">
        <p class="text-xl text-gray-900 sm:text-3xl">
          <%= @post.body %>
        </p>
      </div>

      <% if @post.image.attached? %>
        <div class="mb-10 overflow-hidden rounded-[24px] bg-gray-100">
          <%= image_tag @post.image, class: "h-auto w-full object-cover" %>
        </div>
      <% end %>

      <div class="grid gap-4 sm:grid-cols-2">
        <% if logged_in? && @post.user == current_user %>
          <%= link_to "編集する",
                edit_post_path(@post),
                class: "inline-flex w-full items-center justify-center rounded-2xl bg-gray-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-gray-700" %>
        <% end %>

        <%= link_to "一覧に戻る",
              posts_path,
              class: "inline-flex w-full items-center justify-center rounded-2xl bg-green-600 px-6 py-4 text-lg font-bold text-white transition hover:bg-green-700" %>
      </div>

      <% if logged_in? && @post.user == current_user %>
        <div class="mt-8 text-center">
          <%= button_to "投稿を削除する",
                post_path(@post),
                method: :delete,
                data: { turbo_confirm: "この投稿を削除しますか？" },
                form_class: "inline",
                class: "bg-transparent p-0 text-lg font-bold text-gray-600 underline transition hover:text-red-600" %>
        </div>
      <% end %>
    </section>
  </div>
</main>
